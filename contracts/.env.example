# Copy this file to .env and fill in the deployment-specific values.
# Never commit .env or a real private key.

MONAD_RPC_URL=
DEPLOYER_PRIVATE_KEY=
GUARDIAN_1=
GUARDIAN_2=
GUARDIAN_3=
WORKER_1=
WORKER_2=

# Deployment requires all three guardians to approve (0b111).
GUARDIAN_MASK=7

# Values are block counts. Set these for the target network/demo.
EXPIRY_BLOCKS=
WINDOW_BLOCKS=

# Amount of native token to fund the vault, in wei.
VAULT_FUNDING=0

# Optional: uncomment and fill these to register a vendor as a payee (Jalur A).
# VENDOR_ADDR=0x...
# VENDOR_PER_TX_CAP=1000000000000000000
# VENDOR_PER_WINDOW_CAP=2000000000000000000
