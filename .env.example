NODE_ENV=development
HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000
HOST_TOKEN=replace-with-a-long-random-token
TRUST_PROXY=false
REHEARSAL=true
REHEARSAL_VICTIM_TRICKED=true
MANUAL_ATTACKS_ENABLED=false
PANIC_BLUR=false

# Gemini is skipped when REHEARSAL=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=1200
GUARDIAN_TIMEOUT_MS=250

# Monad Testnet (Chain ID 10143). Live chain operations require all fields below.
MONAD_CHAIN_ID=10143
MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz
MONAD_WS_PRIMARY=wss://testnet-rpc.monad.xyz
MONAD_WS_BACKUP=wss://rpc-testnet.monadinfra.com
AEGIS_VAULT_ADDRESS=
WORKER_PRIVATE_KEYS=
GUARDIAN_1_PRIVATE_KEY=
GUARDIAN_2_PRIVATE_KEY=
GUARDIAN_3_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=
GUARDIAN_MASK=7
MONADSCAN_TX_BASE_URL=https://testnet.monadscan.com/tx/
PROPOSE_GAS_LIMIT=120000
DECISION_GAS_LIMIT=95000
EXECUTE_GAS_LIMIT=120000
MAX_PRIORITY_FEE_GWEI=2

# Guard policy
QUEUE_MAX=12
PLAYER_CAP=40
JOINS_PER_IP=3
ATTACK_COOLDOWN_MS=5000
SERVICE_INTERVAL_MS=1200
MAX_NEW_RECIPIENTS_PER_WINDOW=6
NEW_RECIPIENT_WINDOW_MS=60000
MAX_NEW_RECIPIENT_AMOUNT=5
CLAIMS_FILE=./claims.json
BLOCKED_ADDRESSES=
DEMO_RECIPIENT=0x000000000000000000000000000000000000dEaD
DEMO_AMOUNT=0.1
RAW_DEMO_RECIPIENT=
RAW_DEMO_AMOUNT=0.1
